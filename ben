#!/usr/bin/env bash
#
# BEN DROWNED - one command for setting up, building, patching and running the hack.
#
#   ./ben setup [ROM]   first time: dependencies, your ROM, asset extraction, first build
#   ./ben build         build the hack (redoes any setup step an update needs, automatically)
#   ./ben update        get the latest version of the project and build it
#   ./ben run           open the latest build in your emulator
#   ./ben patch         make the release .bps patch in dist/
#   ./ben doctor        check this machine and explain how to fix any problem
#   ./ben clean         delete build output (fast rebuild, keeps extracted assets)
#   ./ben reset         delete everything generated except your ROM (next build starts fresh)
#   ./ben config        show or change settings (emulator path, Windows copy)
#
# Every step is idempotent and fingerprinted: after `git pull` (or `./ben update`), `./ben build` works out
# whether dependencies, the Python env, extracted assets or the build itself are stale and redoes only those.
# Nothing here is specific to one milestone, so the same commands keep working for every future build.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

GAME_VERSION="${BEN_GAME_VERSION:-n64-us}"
STATE_DIR=".ben"
STAMP_DIR="$STATE_DIR/stamps"
LOG_DIR="$STATE_DIR/logs"
TOOLS_DIR="$STATE_DIR/tools"
CONFIG_FILE="$STATE_DIR/config"
DIST_DIR="dist"
BASEROM_DIR="baseroms/$GAME_VERSION"
BUILD_ROM="build/$GAME_VERSION/mm-$GAME_VERSION-compressed.z64"
# The hack is not byte-identical to the original game, so never ask make to compare checksums.
MAKE_VARS=(VERSION="$GAME_VERSION" NON_MATCHING=1 COMPARE=0)

# Bump DEPS_REV whenever a package list below changes; everyone's next build installs the difference.
DEPS_REV=1
APT_PACKAGES=(git build-essential binutils-mips-linux-gnu curl python3 python3-pip python3-venv libpng-dev
              libxml2-dev pkg-config unzip)
BREW_PACKAGES=(coreutils make python3 libpng bash libxml2 libiconv)
FLIPS_REPO="https://github.com/Alcaro/Flips"
FLIPS_COMMIT="ff216a75df0987047a67d7923567dc4482ce07ac"

# ----------------------------------------------------------------------------------------------------------------
# Output helpers

if [ -t 1 ]; then
    C_RED=$'\e[31m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_RESET=$'\e[0m'
else
    C_RED="" C_GREEN="" C_YELLOW="" C_BOLD="" C_DIM="" C_RESET=""
fi

say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==> %s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
ok()   { printf '  %s✔%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
bad()  { printf '  %s✘%s %s\n' "$C_RED" "$C_RESET" "$*"; }
die()  { printf '\n%sError:%s %s\n' "$C_RED$C_BOLD" "$C_RESET" "$*" >&2; exit 1; }

# Run a long command with its full output going to a log file, showing elapsed time and the latest line.
# On failure, print the first error and where the full log is.
run_logged() {
    local label="$1"; shift
    local log
    log="$LOG_DIR/$(date +%Y%m%d-%H%M%S)-${label// /-}.log"
    mkdir -p "$LOG_DIR"
    ln -sf "$(basename "$log")" "$LOG_DIR/latest.log"

    if [ "${BEN_VERBOSE:-0}" = 1 ] || [ ! -t 1 ]; then
        say "  $label (log: $log)"
        if "$@" 2>&1 | tee "$log"; then return 0; fi
    else
        local start=$SECONDS pid status last cols
        cols=$(( $(tput cols 2>/dev/null || echo 100) - 30 ))
        "$@" >"$log" 2>&1 &
        pid=$!
        while kill -0 "$pid" 2>/dev/null; do
            last="$(tail -n 1 "$log" 2>/dev/null | tr -d '\r' | cut -c1-"$cols")"
            printf '\r\e[K  %s %s[%ds]%s %s' "$label" "$C_DIM" $((SECONDS - start)) "$C_RESET" "$last"
            sleep 1
        done
        status=0; wait "$pid" || status=$?
        printf '\r\e[K'
        if [ "$status" = 0 ]; then ok "$label ($((SECONDS - start))s)"; return 0; fi
    fi

    bad "$label failed"
    local first_error
    first_error="$(grep -m 5 -iE '(error|fatal|no such file|not found|undefined reference)' "$log" || true)"
    [ -n "$first_error" ] && printf '%s\n' "$first_error" | sed 's/^/    /'
    say ""
    say "  Full log: $ROOT/$log"
    say "  If you need help, send that log file (or its last 50 lines: tail -n 50 $log)."
    exit 1
}

# ----------------------------------------------------------------------------------------------------------------
# Platform detection

is_wsl()   { grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; }
is_macos() { [ "$(uname -s)" = Darwin ]; }
is_debian_like() {
    [ -r /etc/os-release ] && grep -qiE '^(ID|ID_LIKE)=.*(debian|ubuntu)' /etc/os-release
}
make_cmd() { if is_macos; then echo gmake; else echo make; fi; }
jobs_count() { nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4; }

# Windows home folder as a WSL path (e.g. /mnt/c/Users/you), or empty. Cached: asking Windows is slow.
WINDOWS_HOME_CACHE=""
windows_home() {
    is_wsl || return 0
    if [ -z "$WINDOWS_HOME_CACHE" ]; then
        local winhome
        winhome="$(cd /mnt/c 2>/dev/null && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r' || true)"
        if [ -n "$winhome" ] && command -v wslpath >/dev/null; then
            WINDOWS_HOME_CACHE="$(wslpath -u "$winhome" 2>/dev/null || true)"
        fi
    fi
    printf '%s' "$WINDOWS_HOME_CACHE"
}

# ----------------------------------------------------------------------------------------------------------------
# Config (.ben/config is a plain KEY=value file you can edit)

config_get() {
    [ -f "$CONFIG_FILE" ] || return 0
    sed -n "s/^$1=//p" "$CONFIG_FILE" | tail -n 1
}
config_set() {
    mkdir -p "$STATE_DIR"
    touch "$CONFIG_FILE"
    grep -v "^$1=" "$CONFIG_FILE" >"$CONFIG_FILE.tmp" || true
    printf '%s=%s\n' "$1" "$2" >>"$CONFIG_FILE.tmp"
    mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
}

# ----------------------------------------------------------------------------------------------------------------
# Fingerprints: a hash of everything a step depends on. A step reruns only when its fingerprint changes.

fingerprint() {
    # Hash tracked file contents (index + uncommitted changes) of the given paths.
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        { git ls-files -s -- "$@"; git diff --no-ext-diff -- "$@"; printf '%s\n' "$@"; } | sha1sum | cut -c1-16
    else
        find "$@" -type f -not -path '*/__pycache__/*' -print0 2>/dev/null | sort -z | xargs -0 sha1sum | sha1sum | cut -c1-16
    fi
}
stamp_matches() { [ -f "$STAMP_DIR/$1" ] && [ "$(cat "$STAMP_DIR/$1")" = "$2" ]; }
stamp_write()   { mkdir -p "$STAMP_DIR"; printf '%s\n' "$2" >"$STAMP_DIR/$1"; }
stamp_clear()   { rm -f "$STAMP_DIR/$1"; }

baserom_file() {
    local ext
    for ext in z64 n64 v64 Z64 N64 V64; do
        [ -f "$BASEROM_DIR/baserom.$ext" ] && { echo "$BASEROM_DIR/baserom.$ext"; return 0; }
    done
    return 1
}

# Inputs to asset extraction: the extractors, their configs and the ROM itself. Our own tools/ben is excluded.
extract_fingerprint() {
    local rom_md5
    rom_md5="$(md5sum "$(baserom_file)" | cut -d' ' -f1)"
    printf '%s %s %s\n' "$rom_md5" \
        "$(fingerprint assets/xml "$BASEROM_DIR" requirements.txt)" \
        "$(git ls-files tools 2>/dev/null | grep -v '^tools/ben/' | tr '\n' '\0' | xargs -0 -r git ls-files -s -- 2>/dev/null | sha1sum | cut -c1-16)"
}

# Inputs that require a clean rebuild when they change. make tracks source files (and the spec) itself, but not
# its own flags or recipe changes.
build_config_fingerprint() {
    printf '%s %s\n' "${MAKE_VARS[*]}" "$(fingerprint Makefile)"
}

needs_disasm() {
    # The decomp is fully decompiled today, so the build needs no disassembly. If that ever changes upstream,
    # this notices and runs it.
    grep -rlqE 'GLOBAL_ASM|INCLUDE_ASM' src 2>/dev/null
}

# ----------------------------------------------------------------------------------------------------------------
# Steps

ensure_location() {
    case "$ROOT" in
        /mnt/[a-z]/*)
            warn "This folder is on the Windows drive ($ROOT). Builds there are 5-10x slower."
            warn "Recommended: clone into your Linux home instead:  cd ~ && git clone https://github.com/StormEf4/BEN-DROWNED.git"
            ;;
    esac
}

missing_apt_packages() {
    local p
    for p in "${APT_PACKAGES[@]}"; do
        dpkg -s "$p" >/dev/null 2>&1 || printf '%s ' "$p"
    done
}

ensure_deps() {
    local stamp_val="deps-$DEPS_REV"
    stamp_matches deps "$stamp_val" && command -v mips-linux-gnu-ld >/dev/null 2>&1 && return 0

    step "Checking system packages"
    if is_debian_like; then
        local missing
        missing="$(missing_apt_packages)"
        if [ -n "$missing" ]; then
            say "  Installing: $missing"
            say "  (this uses sudo, so you may be asked for your Linux password)"
            local sudo=""
            if [ "$(id -u)" != 0 ]; then
                sudo="sudo"
                sudo -v || die "sudo is needed to install packages."  # ask for the password now, in the foreground
            fi
            # shellcheck disable=SC2086
            run_logged "apt-get update" $sudo apt-get update
            # shellcheck disable=SC2086
            run_logged "installing packages" $sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y $missing
        fi
        ok "system packages installed"
    elif is_macos; then
        command -v brew >/dev/null || die "Homebrew is needed on macOS: https://brew.sh"
        run_logged "installing Homebrew packages" brew install "${BREW_PACKAGES[@]}"
        command -v mips-linux-gnu-ld >/dev/null ||
            die "MIPS binutils are missing. Follow 'Building mips-linux-binutils' in docs/BUILDING_MACOS.md, then rerun."
    else
        warn "Unrecognized Linux distribution. Install the equivalents of these packages yourself:"
        say "    ${APT_PACKAGES[*]}"
    fi

    local cmd
    for cmd in git make gcc python3 curl mips-linux-gnu-ld mips-linux-gnu-as; do
        is_macos && [ "$cmd" = make ] && cmd=gmake
        command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' is still missing after installing packages. Run ./ben doctor."
    done
    stamp_write deps "$stamp_val"
}

# Folders worth searching for a ROM the user already has.
rom_search_dirs() {
    local dirs=("$ROOT" "$HOME" "$HOME/Downloads" "$HOME/Desktop")
    local win
    win="$(windows_home)"
    [ -n "$win" ] && dirs+=("$win/Downloads" "$win/Desktop" "$win/Documents" "$win/OneDrive/Desktop" "$win/OneDrive/Documents")
    local d
    for d in "${dirs[@]}"; do [ -d "$d" ] && printf '%s\n' "$d"; done | sort -u
}

ensure_rom() {
    local given="${1:-}" current
    if [ -z "$given" ] && current="$(baserom_file)"; then
        python3 -I tools/ben/rom_tool.py identify "$current" >/dev/null && return 0
        warn "The ROM in $BASEROM_DIR isn't usable: $(python3 -I tools/ben/rom_tool.py identify "$current" | cut -f2)"
    fi

    step "Importing your Majora's Mask ROM"
    if [ -n "$given" ]; then
        [ -f "$given" ] || die "No such file: $given"
        python3 -I tools/ben/rom_tool.py import "$given" || die "That file can't be used (see above). You need the USA N64 version of Majora's Mask."
        return 0
    fi

    say "  Looking for it in your usual folders..."
    local candidates=() dirs=() line
    mapfile -t dirs < <(rom_search_dirs)
    while IFS= read -r line; do
        case "$line" in retail$'\t'*|decompressed$'\t'*) candidates+=("$(printf '%s' "$line" | cut -f2)") ;; esac
        printf '%s\n' "$line" | cut -f3 | sed 's/^/    /'
    done < <(python3 -I tools/ben/rom_tool.py find "${dirs[@]}" --depth 2 || true)

    if [ "${#candidates[@]}" -ge 1 ]; then
        python3 -I tools/ben/rom_tool.py import "${candidates[0]}"
        return 0
    fi

    say ""
    say "  I couldn't find a usable ROM. Give me its location:"
    if is_wsl; then
        say "    ./ben setup \"/mnt/c/Users/<you>/Downloads/Majora's Mask (USA).z64\""
        say "  (a Windows path like C:\\Users\\... becomes /mnt/c/Users/...)"
    else
        say "    ./ben setup /path/to/majoras-mask-usa.z64"
    fi
    say "  .z64, .n64 and .v64 files all work. It must be the USA Nintendo 64 version."
    exit 1
}

ensure_venv() {
    local fp
    fp="$(fingerprint requirements.txt)"
    if [ -x .venv/bin/python3 ] && stamp_matches venv "$fp"; then return 0; fi
    step "Setting up the Python environment"
    run_logged "python packages" "$(make_cmd)" venv
    stamp_write venv "$fp"
}

ensure_extracted() {
    local fp
    fp="$(extract_fingerprint)"
    if stamp_matches extract "$fp" && [ -d "extracted/$GAME_VERSION/assets" ]; then return 0; fi

    step "Extracting game assets from your ROM"
    if [ -f "$STAMP_DIR/extract" ]; then
        say "  The project's extraction tools or your ROM changed since last time, so assets are re-extracted."
    else
        say "  First time only. This usually takes 5-15 minutes."
    fi
    stamp_clear build-config
    run_logged "clearing old assets" "$(make_cmd)" "VERSION=$GAME_VERSION" assetclean
    run_logged "building tools" "$(make_cmd)" -C tools -j"$(jobs_count)"
    run_logged "reading the ROM" "$(make_cmd)" "VERSION=$GAME_VERSION" setup
    run_logged "extracting assets" "$(make_cmd)" "VERSION=$GAME_VERSION" assets
    if needs_disasm; then
        run_logged "disassembling" "$(make_cmd)" "VERSION=$GAME_VERSION" disasm
    fi
    stamp_write extract "$fp"
}

ensure_flips() {
    if command -v flips >/dev/null 2>&1; then command -v flips; return 0; fi
    local flips="$TOOLS_DIR/flips/flips"
    if [ -x "$flips" ] && stamp_matches flips "$FLIPS_COMMIT"; then echo "$ROOT/$flips"; return 0; fi
    step "Building Flips (the patch tool)" >&2
    rm -rf "$TOOLS_DIR/flips"
    mkdir -p "$TOOLS_DIR"
    run_logged "downloading Flips" git clone -q "$FLIPS_REPO" "$TOOLS_DIR/flips" >&2
    run_logged "checking out pinned version" git -C "$TOOLS_DIR/flips" checkout -q "$FLIPS_COMMIT" >&2
    run_logged "compiling Flips" "$(make_cmd)" -C "$TOOLS_DIR/flips" TARGET=cli CFLAGS=-O2 >&2
    stamp_write flips "$FLIPS_COMMIT"
    echo "$ROOT/$flips"
}

build_version() { git describe --tags --always --dirty 2>/dev/null || echo dev; }

publish_build() {
    local version name win_dir
    version="$(build_version)"
    name="BEN-DROWNED-$version.z64"
    mkdir -p "$DIST_DIR"
    cp -f "$BUILD_ROM" "$DIST_DIR/$name"
    cp -f "$BUILD_ROM" "$DIST_DIR/BEN-DROWNED-latest.z64"
    ok "ROM: $ROOT/$DIST_DIR/$name"

    if is_wsl && [ "$(config_get WINDOWS_COPY)" != 0 ]; then
        win_dir="$(windows_home)"
        if [ -n "$win_dir" ]; then
            win_dir="$win_dir/BEN-DROWNED"
            mkdir -p "$win_dir"
            cp -f "$BUILD_ROM" "$win_dir/$name"
            cp -f "$BUILD_ROM" "$win_dir/BEN-DROWNED-latest.z64"
            ok "Windows copy: $(wslpath -w "$win_dir/BEN-DROWNED-latest.z64" 2>/dev/null || echo "$win_dir")"
        fi
    fi
}

do_build() {
    ensure_location
    ensure_deps
    ensure_rom ""
    ensure_venv
    ensure_extracted

    local cfg
    cfg="$(build_config_fingerprint)"
    if ! stamp_matches build-config "$cfg" && [ -d "build/$GAME_VERSION" ]; then
        step "Build settings changed, starting from a clean build"
        run_logged "cleaning" "$(make_cmd)" "VERSION=$GAME_VERSION" clean
    fi

    step "Building BEN DROWNED ($(build_version))"
    run_logged "compiling" "$(make_cmd)" -j"$(jobs_count)" "${MAKE_VARS[@]}" all
    stamp_write build-config "$cfg"

    run_logged "checking text IDs" .venv/bin/python3 tools/ben/check_text_ids.py --version "$GAME_VERSION"
    publish_build
    say ""
    say "${C_GREEN}${C_BOLD}Done.${C_RESET} Open the ROM above in ares, or run: ./ben run"
}

# ----------------------------------------------------------------------------------------------------------------
# Commands

cmd_setup() {
    say "${C_BOLD}BEN DROWNED setup${C_RESET}"
    say "This installs what the build needs, imports your ROM, extracts the game's assets and builds the hack."
    ensure_location
    ensure_deps
    ensure_rom "${1:-}"
    do_build
    say ""
    say "From now on, just run ${C_BOLD}./ben build${C_RESET} (or ${C_BOLD}./ben update${C_RESET} to get the newest version first)."
}

cmd_build() {
    [ "${1:-}" = "--clean" ] && { stamp_clear build-config; rm -rf "build/$GAME_VERSION"; }
    do_build
}

cmd_update() {
    step "Getting the latest version"
    git diff --quiet && git diff --cached --quiet || die "You have local changes. Commit or stash them first (git stash), then rerun."
    run_logged "git pull" git pull --ff-only
    do_build
}

find_emulator() {
    local configured
    configured="$(config_get EMULATOR)"
    if [ -n "$configured" ] && [ -e "$configured" ]; then echo "$configured"; return 0; fi
    command -v ares >/dev/null 2>&1 && { command -v ares; return 0; }
    if is_wsl; then
        local win candidate
        win="$(windows_home)"
        for candidate in "/mnt/c/Program Files/ares/ares.exe" "$win/ares/ares.exe" "$win/Desktop/ares/ares.exe"; do
            [ -f "$candidate" ] && { echo "$candidate"; return 0; }
        done
        candidate="$(find "$win/Downloads" "$win/Desktop" "$win/Documents" -maxdepth 3 -iname 'ares.exe' 2>/dev/null | head -n 1 || true)"
        [ -n "$candidate" ] && { echo "$candidate"; return 0; }
    fi
    if is_macos && [ -d /Applications/ares.app ]; then echo "/Applications/ares.app"; return 0; fi
    return 1
}

cmd_run() {
    local rom="$DIST_DIR/BEN-DROWNED-latest.z64" emu
    [ -f "$rom" ] || die "No build yet. Run ./ben build first."
    emu="$(find_emulator)" || die "Couldn't find ares. Install it from https://ares-emu.net, then tell me where it is:
    ./ben config EMULATOR \"/mnt/c/path/to/ares.exe\""
    config_set EMULATOR "$emu"
    say "Starting $(basename "$emu") with $rom"
    case "$emu" in
        *.exe)  local win_rom; win_rom="$(windows_home)/BEN-DROWNED/BEN-DROWNED-latest.z64"
                [ -f "$win_rom" ] || win_rom="$ROOT/$rom"
                # `start` detaches the emulator so it keeps running after this terminal closes.
                (cd /mnt/c && cmd.exe /c start "" "$(wslpath -w "$emu")" "$(wslpath -w "$win_rom")") ;;
        *.app)  open -a "$emu" "$ROOT/$rom" ;;
        *)      ("$emu" "$ROOT/$rom" >/dev/null 2>&1 &) ;;
    esac
}

cmd_patch() {
    do_build
    local flips
    flips="$(ensure_flips)"
    step "Making the release patch"
    PATH="$(dirname "$flips"):$PATH" tools/ben/make_patch.sh "$(baserom_file)"
}

cmd_doctor() {
    local problems=0
    say "${C_BOLD}BEN DROWNED doctor${C_RESET}  ($(build_version), $(uname -sm))"

    step "Machine"
    if is_wsl; then ok "Windows (WSL2)"; elif is_macos; then ok "macOS"; else ok "Linux"; fi
    case "$ROOT" in /mnt/[a-z]/*) bad "project is on the Windows drive (slow builds): $ROOT"; problems=$((problems + 1)) ;;
                    *) ok "project folder: $ROOT" ;; esac
    local free_gb
    free_gb="$(df -Pk . | awk 'NR==2 {print int($4 / 1048576)}')"
    if [ "$free_gb" -ge 6 ]; then ok "free disk space: ${free_gb} GB"; else bad "only ${free_gb} GB free (need about 6 GB)"; problems=$((problems + 1)); fi

    step "Tools"
    local cmd
    for cmd in git "$(make_cmd)" gcc g++ python3 curl pkg-config mips-linux-gnu-ld mips-linux-gnu-as; do
        if command -v "$cmd" >/dev/null 2>&1; then ok "$cmd"; else bad "$cmd missing  ->  ./ben setup installs it"; problems=$((problems + 1)); fi
    done
    if python3 -c 'import venv, ensurepip' >/dev/null 2>&1; then ok "python3 venv"; else bad "python3-venv missing  ->  ./ben setup installs it"; problems=$((problems + 1)); fi
    if pkg-config --exists libpng 2>/dev/null; then ok "libpng"; else bad "libpng missing  ->  ./ben setup installs it"; problems=$((problems + 1)); fi

    step "Your ROM"
    local rom
    if rom="$(baserom_file)"; then
        local line; line="$(python3 -I tools/ben/rom_tool.py identify "$rom" || true)"
        case "$line" in retail*|decompressed*) ok "$(printf '%s' "$line" | cut -f2)" ;;
                        *) bad "$(printf '%s' "$line" | cut -f2)"; problems=$((problems + 1)) ;; esac
    else
        bad "no ROM imported yet  ->  ./ben setup /path/to/your/rom.z64"; problems=$((problems + 1))
    fi

    step "Project state"
    if [ -x .venv/bin/python3 ] && stamp_matches venv "$(fingerprint requirements.txt)"; then ok "Python environment up to date"; else warn "Python environment will be (re)built on next build"; fi
    if baserom_file >/dev/null && stamp_matches extract "$(extract_fingerprint)"; then ok "extracted assets up to date"; else warn "assets will be (re)extracted on next build"; fi
    if [ -f "$DIST_DIR/BEN-DROWNED-latest.z64" ]; then ok "latest build: $DIST_DIR/BEN-DROWNED-latest.z64 ($(date -r "$DIST_DIR/BEN-DROWNED-latest.z64" '+%Y-%m-%d %H:%M'))"; else warn "not built yet"; fi
    local emu
    if emu="$(find_emulator)"; then ok "emulator: $emu"; else warn "ares not found (only needed for ./ben run)"; fi

    say ""
    if [ "$problems" = 0 ]; then say "${C_GREEN}Everything looks good.${C_RESET}"; else say "${C_RED}$problems problem(s) found.${C_RESET} Most are fixed by: ./ben setup"; fi
    [ "$problems" = 0 ]
}

cmd_clean() {
    run_logged "cleaning build output" "$(make_cmd)" "VERSION=$GAME_VERSION" clean
    stamp_clear build-config
}

cmd_reset() {
    say "This deletes extracted assets, build output, the Python environment and cached tools. Your ROM is kept."
    if [ -t 0 ]; then
        read -r -p "Continue? [y/N] " answer
        case "$answer" in [yY]*) ;; *) say "Cancelled."; return 0 ;; esac
    fi
    run_logged "removing generated files" "$(make_cmd)" "VERSION=$GAME_VERSION" distclean
    rm -rf .venv "$STAMP_DIR" "$TOOLS_DIR" "$BASEROM_DIR/baserom-decompressed.z64"
    ok "reset. Next ./ben build starts from scratch."
}

cmd_config() {
    if [ $# -eq 0 ]; then
        [ -f "$CONFIG_FILE" ] && cat "$CONFIG_FILE" || say "(no settings yet)"
        say ""
        say "Settings: EMULATOR=<path to ares>   WINDOWS_COPY=0|1 (copy builds to your Windows user folder, default 1)"
        return 0
    fi
    [ $# -eq 2 ] || die "usage: ./ben config KEY VALUE"
    config_set "$1" "$2"
    ok "$1=$2"
}

cmd_help() {
    sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
    say "Options: BEN_VERBOSE=1 ./ben build   shows the full compiler output instead of a progress line."
}

main() {
    local cmd="${1:-help}"
    [ $# -gt 0 ] && shift
    case "$cmd" in
        setup)  cmd_setup "$@" ;;
        build)  cmd_build "$@" ;;
        update) cmd_update ;;
        run)    cmd_run ;;
        patch)  cmd_patch ;;
        doctor) cmd_doctor ;;
        clean)  cmd_clean ;;
        reset)  cmd_reset ;;
        config) cmd_config "$@" ;;
        help|-h|--help) cmd_help ;;
        *) die "unknown command '$cmd'. Run ./ben help" ;;
    esac
}

# Allow `source ./ben` (for testing individual steps) without running a command.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
